      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(pbp_ehi_decision_seconds_count{decision=\"APPROVE\"}[15m])) / sum(rate(pbp_ehi_decision_seconds_count{type!~\"PRESENTMENT|REVERSAL\"}[15m]))",
          "legendFormat": "",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
