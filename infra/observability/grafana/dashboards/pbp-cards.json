{
  "uid": "pbp-cards",
  "title": "PBP \u00b7 Cards and EHI",
  "description": "Thredd's real-time authorisations answered by ehi-responder, and settlement.",
  "tags": [
    "pbp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pbp"
      ],
      "asDropdown": true,
      "title": "PBP dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Decisions /s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(pbp_ehi_decision_seconds_count[5m])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Approval rate",
      "description": "",
