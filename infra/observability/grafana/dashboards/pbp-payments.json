{
  "uid": "pbp-payments",
  "title": "PBP \u00b7 Payments",
  "description": "Faster Payments, CHAPS, internal transfers, inbound and Bacs credits. Counted from payment_status_history.",
  "tags": [
    "pbp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pbp"
      ],
      "asDropdown": true,
      "title": "PBP dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "type",
        "label": "Payment type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(pbp_payment_transitions_total, type)",
          "refId": "v"
        },
        "definition": "label_values(pbp_payment_transitions_total, type)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Completed (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pbp_payment_transitions_total{type=~\"$type\", status=\"COMPLETED\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Failed or rejected (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pbp_payment_transitions_total{type=~\"$type\", status=~\"FAILED|REJECTED\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Held for review",
