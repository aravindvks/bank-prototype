      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(max without (instance, service) (pbp_payments_open{type=~\"$type\", status=\"HELD\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "exemplar": true
