      "targets": [
        {
          "expr": "sum by (status) (rate(pbp_payment_transitions_total{type=~\"$type\"}[5m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
