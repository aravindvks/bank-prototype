      "targets": [
        {
          "expr": "sort_desc(sum by (type, status, reason) (increase(pbp_payment_transitions_total{type=~\"$type\", status=~\"FAILED|REJECTED|RETURNED\"}[24h])) > 0)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
